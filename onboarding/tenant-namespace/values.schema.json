{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "tenant-namespace-onboarding values",
  "type": "object",
  "required": ["namespace", "globalConfigNamespace", "accountId", "region", "families"],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "description": "Resource namespace being onboarded."
    },
    "globalConfigNamespace": {
      "type": "string",
      "minLength": 1,
      "description": "Namespace holding the global-tier KropathConfig/<Family>Config baseline."
    },
    "accountId": {
      "type": "string",
      "pattern": "^[0-9]{12}$",
      "description": "12-digit AWS account ID (ADR-015 §5.8.2 rule 1)."
    },
    "region": {
      "type": "string",
      "minLength": 1,
      "description": "AWS region, e.g. ap-southeast-2."
    },
    "configRef": {
      "type": "string",
      "minLength": 1,
      "default": "general-policy"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Family slugs to onboard — see family-kind-map.yaml for accepted values."
    }
  }
}
